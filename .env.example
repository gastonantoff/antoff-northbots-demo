# Copiá estas variables en la configuración local de tu equipo.
# Nunca subas un archivo .env con valores reales.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_IG_USER_ID=
INSTAGRAM_VERIFY_TOKEN=

# Se completa cuando definamos la versión activa de Graph API.
INSTAGRAM_GRAPH_API_VERSION=

# Proveedor de IA opcional. Si se omiten, cada asistente usa su configuración.
# Valores admitidos: ollama_local, cloudflare_workers_ai, gemini_api
IA_PROVEEDOR=
IA_MODELO=

# Cloudflare Workers AI. Nunca publiques ni subas el token real.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_WORKERS_AI_TOKEN=

# Gemini API. Crear la clave en Google AI Studio y cargarla solo
# como variable secreta del proveedor donde se publique la demo.
GEMINI_API_KEY=
